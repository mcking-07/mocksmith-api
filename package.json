{
  "name": "mocksmith-api",
  "version": "1.0.0",
  "description": "a simple api to forge mocks with ease.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "test": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply mocksmith --local",
    "db:migrate:remote": "wrangler d1 migrations apply mocksmith --remote"
  },
  "author": "muzammil_07",
  "license": "MIT",
  "dependencies": {
    "@cf-wasm/quickjs": "^0.2.5",
    "acorn": "8.16.0",
    "acorn-walk": "8.3.5",
    "jose": "6.1.3",
    "path-to-regexp": "8.4.0",
    "safe-wrapper": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "10.0.1",
    "@types/node": "25.3.3",
    "eslint": "10.0.2",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "typescript-eslint": "8.56.1",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  }
}
